@startuml
skinparam classAttributeIconSize 0

class Product {
- id : Long
- name : String
- price : double
+ getName() : String
+ getPrice() : double
}

class DigitalProduct {
- downloadUrl : String
- filzeSize : double
+ getDownloadUrl() : String
+ getFilzeSize() : double
}

class PhysicalProduct {
- weightKg : double
- shippingCost : double
+ getWeightKg() : double
+ getShippingCost() : double
}

Product <|-- DigitalProduct
Product <|-- PhysicalProduct
@enduml
